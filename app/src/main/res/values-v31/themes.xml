<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The animated icon only plays on Android 12+; older versions show its first frame, so they keep the static one. -->
    <style name="Theme.Muuusic.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Muuusic</item>
    </style>
</resources>
