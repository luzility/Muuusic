thumbnail": {"thumbnails": [{"url": "https://yt3.googleusercontent.com/6EI_AGtb-1uKlogKuDjL89UL59IoPEgSuPYQVcVxHAMX35dHJSFraYXIXIi9GSzJKalS7_Zf-Ko=w226-h226-l90-rj-dcqSKUE5EK", "width": 226, "height": 226}, {"url": "https://yt3.googleusercontent.com/6EI_AGtb-1uKlogKuDjL89UL59IoPEgSuPYQVcVxHAMX35dHJSFraYXIXIi9GSzJKalS7_Zf-Ko=w544-h544-l90-rj-dcqSKUE5EK", "width": 544, "height": 544}]}, "thumbnailCrop": "MUSIC_THUMBNAIL_CROP_CIRCLE", "thumbnailScale": "MUSIC_THUMBNAIL_SCALE_ASPECT_FILL"}}, "aspectRatio": "MUSIC_TWO_ROW_ITEM_THUMBNAIL_ASPECT_RATIO_SQUARE", "title": {"runs": [{"text": "Sila", "navigationEndpoint": {"browseEndpoint": {"browseId": "UCb01oggAWzVblripV8CHTdw", "browseEndpointContextSupportedConfigs": {"browseEndpointContextMusicConfig": {"pageType": "MUSIC_PAGE_TYPE_ARTIST"}}}}}]}, "subtitle": {"runs": [{"text": "Aylık kitle: 8,24 Mn"}]}, "navigationEndpoint": {"browseEndpoint": {"browseId": "UCb01oggAWzVblripV8CHTdw", "browseEndpointContextSupportedConfigs": {"browseEndpointContextMusicConfig": {"pageType": "MUSIC_PAGE_TYPE_ARTIST"}}}}}}], "itemSize": "COLLECTION_STYLE_ITEM_SIZE_MEDIUM"}}, {"musicDescriptionShelfRenderer": {"header": {"runs": [{"text": "Hakkında"}]}, "subheader": {"runs": [{"text": "3.881.016.149 görüntüleme"}]}, "description": {"runs": [{"text": "Tarkan, kariyerine başladığı 1992’de İstanbul Plak’ın yayınladığı ilk albümü Yine Sensiz ile 800.000 adet satışa ulaştı. 1994’te İstanbul Plak etiketiyle yayınlanan Aacayipsin ise 2.300.000 adet sattı. Aynı yıl single’ı Şıkıdım, Türkiye’de büyük yankı uyandırdıktan sonra Shikidim ismiyle uluslararası piyasada liste başı oldu. 1997’de 2.400.000 satışa ulaşan üçüncü albümü Ölürüm Sana ile başarısını pekiştirdi. Albümün ilk single’ı Şımarık, dünya çapında yankı uyandırdı. Single, 1.000.000 adet satışı ile Billboard’un en iyi çıkış yapan 100 şarkısı listesinde bir numara oldu. 4. albümü Karma, 2001’de piyasaya çıktı. Albümün ilk single’ı Kuzu Kuzu, üç ay boyunca liste başında kaldı ve 600.000 satışa ulaştı. 2003 yılında çıkan 5. albümü Dudu, Türkiye’de 1.500.000‘dan fazla sattı. Çıkış şarkısı Dudu, Rusya’da “Yılın Şarkısı” oldu. 2006’da İngilizce albümü Come Closer Universal Music Almanya etiketiyle yayınlandı. 2007’de çıkan Metamorfoz, müzik endüstrisi genelinde fiziksel satışların düşüşe geçtiği bir dönemde 400.000 sattı. 2010’da DMC tarafından yayınlanan 8. albümü Adımı Kalbine Yaz, Türkiye’de yarım milyona yakın fiziksel satış ve milyonlarca indirme sayısı ile büyük başarıya imza attı. 2016’da Ahde Vefa isimli TSM albümü HITT Müzik etiketiyle yayınladı. Tarkan’ın uzun süre beklenen pop albümü “10”, 2017’de müzikseverlerle buluştu.  “10”, İngiltere, Almanya, Fransa, Hollanda gibi birçok Avrupa ülkesinin yanı sıra Kırgızistan ve Katar’da listelere üst sıralardan giriş yaptı."}]}, "moreButton": {"toggleButtonRenderer": {"isToggled": false, "isDisabled": false, "defaultIcon": {"iconType": "EXPAND"}, "defaultText": {"runs": [{"text": "Daha fazla"}]}, "toggledIcon": {"iconType": "COLLAPSE"}, "toggledText": {"runs": [{"text": "Daha az göster"}]}}}}}]}}}}]}}}